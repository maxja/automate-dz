# Copy this file to .env.secrets and fill in your 1Password secret references.
# Format: op://<vault>/<item>/<field>
# See: https://developer.1password.com/docs/cli/secret-references/

# ── Proxmox ────────────────────────────────────────────────────────────────────
PROXMOX_VE_ENDPOINT="https://{proxmox_host}:8006"
PROXMOX_VE_API_TOKEN="op://{vault}/{item}/api-token"
PROXMOX_VE_INSECURE="false"

TF_VAR_proxmox_endpoint=${PROXMOX_VE_ENDPOINT}
TF_VAR_proxmox_api_token=${PROXMOX_VE_API_TOKEN}
TF_VAR_proxmox_insecure=${PROXMOX_VE_INSECURE}

TF_VAR_pve_node="{proxmox_node_name}"
TF_VAR_ssh_public_key="op://{vault}/{item}/public-key"

# ── Steam ──────────────────────────────────────────────────────────────────────
# Required to download the DayZ dedicated server via SteamCMD (App ID 223350).
# The account must own DayZ.
DAYZ_STEAM_USERNAME="op://{vault}/{item}/username"
DAYZ_STEAM_PASSWORD="op://{vault}/{item}/password"

# ── DayZ Server ────────────────────────────────────────────────────────────────
# DAYZ_SERVER_PASSWORD  — join password shown to players connecting to the server
# DAYZ_ADMIN_PASSWORD   — in-game admin password (passwordAdmin in serverDZ.cfg)
# DAYZ_RCON_PASSWORD    — BattlEye/RCON channel password for remote administration
DAYZ_SERVER_PASSWORD="op://{vault}/{item}/server-password"
DAYZ_ADMIN_PASSWORD="op://{vault}/{item}/admin-password"
DAYZ_RCON_PASSWORD="op://{vault}/{item}/rcon-password"
